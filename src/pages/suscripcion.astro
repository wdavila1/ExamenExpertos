---
import Layout from '@/layouts/Layout.astro'
import PageHeader from '@/components/sections/PageHeader.astro'
import ReservationForm from '@/components/sections/ReservationForm'
import { restaurantInfo, businessHours } from '@/data/restaurant'

const pageTitle = 'Reservar Mesa'
const pageDescription =
  'Reserva tu mesa en Café Premium Copán de forma rápida y sencilla. Disfruta de la mejor comida típica hondureña en un ambiente familiar.'
const pageKeywords =
  'reservar mesa, reservas restaurante, reservar baleadas, cena familiar, almuerzo ejecutivo, Tegucigalpa'

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ReservationPage',
  name: 'Reservaciones en Café Premium Copán',
  description: pageDescription,
  publisher: {
    '@type': 'Restaurant',
    name: 'Café Premium Copán',
    telephone: restaurantInfo.phone
  }
}
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <PageHeader
    title='Reservaciones'
    subtitle='Asegura tu mesa y vive una experiencia gastronómica inolvidable'
    backgroundImage='/images/contact-us-01.webp'
  />

  <div class='mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8'>
    <div class='grid grid-cols-1 items-start gap-12 lg:grid-cols-12'>
      {/* Information Sidebar */}
      <div class='bg-muted/40 border-border/60 space-y-8 rounded-2xl border p-6 sm:p-8 lg:col-span-4'>
        <div class='space-y-3'>
          <h3 class='text-foreground font-serif text-xl font-bold'>Información Importante</h3>
          <p class='text-muted-foreground text-sm leading-relaxed'>
            Para garantizar el mejor servicio, por favor considera los siguientes puntos al realizar tu reserva:
          </p>
        </div>

        <ul class='text-muted-foreground space-y-4 text-sm'>
          <li class='flex gap-3'>
            <span class='text-primary font-bold'>•</span>
            <span>Las reservaciones deben hacerse con al menos <strong>2 horas de anticipación</strong>.</span>
          </li>
          <li class='flex gap-3'>
            <span class='text-primary font-bold'>•</span>
            <span
              >Mantenemos tu mesa reservada por un máximo de <strong>15 minutos de tolerancia</strong> de la hora acordada.</span
            >
          </li>
          <li class='flex gap-3'>
            <span class='text-primary font-bold'>•</span>
            <span
              >Para grupos de más de 10 personas o eventos privados, por favor contáctanos directamente a nuestro
              teléfono de atención o correo electrónico.</span
            >
          </li>
        </ul>

        <div class='border-border/80 space-y-4 border-t pt-6'>
          <h4 class='text-foreground font-serif font-bold'>Horarios de Reservación</h4>
          <div class='text-muted-foreground space-y-2 text-xs'>
            {
              businessHours.map(item => (
                <div class='flex justify-between'>
                  <span>{item.day}:</span>
                  <span class='font-medium'>{item.isOpen ? item.hours : 'Cerrado'}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class='border-border/80 space-y-3 border-t pt-6'>
          <h4 class='text-foreground font-serif font-bold'>¿Necesitas ayuda inmediata?</h4>
          <p class='text-muted-foreground text-sm'>Llámanos o escríbenos directamente:</p>
          <p class='text-primary text-sm font-semibold'>{restaurantInfo.phone} / {restaurantInfo.whatsapp}</p>
        </div>
      </div>

      {/* Reservation Form Component */}
      <div class='lg:col-span-8'>
        <ReservationForm client:load />
      </div>
    </div>
  </div>
</Layout>
