---
import Layout from '@/layouts/Layout.astro'
import PageHeader from '@/components/sections/PageHeader.astro'
import SpecialCategories from '@/components/sections/SpecialCategories'

const pageTitle = 'Lotes Especiales & Micro-lotes'
const pageDescription =
  'Descubre nuestra selección exclusiva de Lotes Especiales y Micro-lotes de café premium de Copán. Granos únicos con cosecha premium y precios exclusivos por tiempo limitado.'
const pageKeywords = 'lotes especiales, micro-lotes, café premium, copán, exclusivo, cosecha premium, café de altura'
---

<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords}>
  <PageHeader
    title='Ediciones Especiales'
    subtitle='Cafés exclusivos de altura y micro-lotes de edición limitada'
    backgroundImage='/images/new-items/new-items-01.webp'
  />

  <div class='mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8'>
    <SpecialCategories client:load />
  </div>
</Layout>
