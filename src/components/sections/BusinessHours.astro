---
import { businessHours, restaurantInfo } from '@/data/restaurant'

// Get current day of the week in Spanish to highlight it
const daysOfWeek = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']
const currentDaySpanish = daysOfWeek[new Date().getDay()]
---

<section class="py-16 sm:py-24 bg-card relative overflow-hidden">
  {/* Soft background shape */}
  <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-primary/5 blur-3xl"></div>
  <div class="absolute -left-16 -top-16 w-64 h-64 rounded-full bg-secondary/5 blur-3xl"></div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

      {/* Text column */}
      <div class="lg:col-span-5 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/5 text-primary text-sm font-medium">
          Horarios de Atención
        </div>
        <h2 class="text-3xl font-bold font-serif md:text-4xl text-foreground tracking-tight">
          ¿Cuándo nos visitas?
        </h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          Ven a disfrutar del auténtico sazón catracho con tu familia y amigos. Estamos ubicados en una zona accesible y contamos con parqueo y seguridad para tu total comodidad.
        </p>

        <div class="space-y-4 pt-4 border-t border-border">
          <div class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <p class="font-bold text-foreground">Dirección</p>
              <p class="text-muted-foreground">{restaurantInfo.address}</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <p class="font-bold text-foreground">Teléfono & Reservas</p>
              <p class="text-muted-foreground">{restaurantInfo.phone} / WhatsApp: {restaurantInfo.whatsapp}</p>
            </div>
          </div>
        </div>
      </div>

      {/* Hours list column */}
      <div class="lg:col-span-7">
        <div class="border border-border/80 bg-background/50 backdrop-blur-md rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
          <h3 class="text-xl font-bold font-serif text-foreground border-b border-border pb-4 flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-primary"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            Horarios Semanales
          </h3>

          <div class="divide-y divide-border/60">
            {businessHours.map((item) => {
              const isToday = item.day === currentDaySpanish
              return (
                <div class={`flex justify-between items-center py-3.5 ${isToday ? 'bg-primary/5 -mx-4 px-4 rounded-lg font-semibold text-primary' : ''}`}>
                  <div class="flex items-center gap-3">
                    <span class="text-base text-foreground font-medium">{item.day}</span>
                    {isToday && (
                      <span class="bg-primary text-primary-foreground text-xs px-2 py-0.5 rounded-full font-bold uppercase tracking-wider">
                        Hoy
                      </span>
                    )}
                  </div>
                  <span class={`text-sm ${isToday ? 'text-primary font-bold' : 'text-muted-foreground'}`}>
                    {item.isOpen ? item.hours : 'Cerrado'}
                  </span>
                </div>
              )
            })}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
