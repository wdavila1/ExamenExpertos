---
interface Props {
  title: string
  subtitle?: string
  backgroundImage?: string
}

const {
  title,
  subtitle,
  backgroundImage = '/images/about-us.webp'
} = Astro.props
---

<section class="relative overflow-hidden bg-zinc-950 py-16 md:py-24 text-white">
  {/* Background image with overlay */}
  <div class="absolute inset-0 z-0">
    <img
      src={backgroundImage}
      alt={title}
      class="h-full w-full object-cover object-center opacity-30 select-none"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/80 to-background/50"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    {/* Top row with Back Button and Breadcrumbs */}
    <div class="relative mb-4 flex justify-center items-center min-h-[32px]">
      {/* Back Button - Positioned absolutely to the left */}
      <div class="absolute right-0 z-20">
        <button onclick="window.history.back()" class="inline-flex items-center gap-1.5 px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium text-white/90 bg-white/10 hover:bg-white/20 backdrop-blur-md rounded-full transition-all border border-white/10 cursor-pointer shadow-sm hover:shadow-md">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <span class="hidden sm:inline">Retroceder</span>
        </button>
      </div>

      {/* Breadcrumbs */}
      <nav class="flex justify-center text-sm font-medium text-primary/80">
        <ol class="inline-flex items-center space-x-1 md:space-x-2">
          <li class="inline-flex items-center">
            <a href="/" class="hover:text-primary transition-colors duration-200">Inicio</a>
          </li>
          <li class="flex items-center">
            <span class="mx-2 text-zinc-500">/</span>
            <span class="text-zinc-300">{title}</span>
          </li>
        </ol>
      </nav>
    </div>

    {/* Title */}
    <h1 class="font-serif text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl text-balance">
      {title}
    </h1>

    {/* Subtitle */}
    {subtitle && (
      <p class="mx-auto mt-4 max-w-2xl text-lg md:text-xl text-muted-foreground text-balance">
        {subtitle}
      </p>
    )}

    {/* Decorative line */}
    <div class="mt-6 flex justify-center">
      <div class="h-1 w-16 rounded-full bg-primary"></div>
    </div>
  </div>
</section>
