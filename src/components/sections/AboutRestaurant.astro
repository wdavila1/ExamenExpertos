---
import { aboutContent, teamMembers, stats } from '@/data/restaurant'
import { Card, CardContent, CardTitle } from '@/components/ui/card'
---

<section class="py-16 sm:py-24 space-y-24">
  
  {/* History & Stats Section */}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-6 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/5 text-primary text-sm font-medium">
          Nuestras Raíces
        </div>
        <h2 class="text-3xl font-bold font-serif md:text-4xl text-foreground tracking-tight">
          {aboutContent.history.title}
        </h2>
        <p class="text-muted-foreground text-lg leading-relaxed text-balance">
          {aboutContent.history.content}
        </p>
      </div>
      
      <div class="lg:col-span-6 grid grid-cols-2 gap-6">
        {stats.map((stat) => (
          <div class="bg-muted/40 border border-border/80 rounded-2xl p-6 text-center space-y-2 hover:border-primary/45 transition-colors duration-300">
            <p class="text-4xl sm:text-5xl font-bold font-serif text-primary">{stat.value}</p>
            <p class="text-sm font-semibold text-muted-foreground uppercase tracking-wider">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Mission & Vision Section */}
  <div class="bg-muted/40 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        {/* Mission */}
        <Card class="border border-border/60 p-6 sm:p-8 rounded-2xl shadow-xs bg-card hover:shadow-md transition-shadow duration-300">
          <CardContent class="p-0 space-y-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
            </div>
            <CardTitle class="text-2xl font-bold font-serif text-foreground">
              {aboutContent.mission.title}
            </CardTitle>
            <p class="text-muted-foreground text-base leading-relaxed">
              {aboutContent.mission.content}
            </p>
          </CardContent>
        </Card>

        {/* Vision */}
        <Card class="border border-border/60 p-6 sm:p-8 rounded-2xl shadow-xs bg-card hover:shadow-md transition-shadow duration-300">
          <CardContent class="p-0 space-y-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/10 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
            </div>
            <CardTitle class="text-2xl font-bold font-serif text-foreground">
              {aboutContent.vision.title}
            </CardTitle>
            <p class="text-muted-foreground text-base leading-relaxed">
              {aboutContent.vision.content}
            </p>
          </CardContent>
        </Card>

      </div>
    </div>
  </div>

  {/* Values Section */}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
      <h3 class="text-3xl font-bold font-serif text-foreground">Nuestros Valores</h3>
      <p class="text-muted-foreground">Los pilares fundamentales sobre los cuales construimos cada platillo y recibimos a cada cliente.</p>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {aboutContent.values.map((value, index) => (
        <div class="bg-card border border-border/60 rounded-2xl p-6 hover:shadow-md hover:border-primary/30 transition-all duration-300 text-center space-y-3">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-bold">
            {index + 1}
          </div>
          <h4 class="text-lg font-bold text-foreground">{value.title}</h4>
          <p class="text-sm text-muted-foreground leading-relaxed">{value.description}</p>
        </div>
      ))}
    </div>
  </div>

  {/* Team Section */}
  <div class="bg-muted/40 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary/30 bg-primary/5 text-primary text-sm font-medium">
          Nuestro Equipo
        </div>
        <h3 class="text-3xl font-bold font-serif text-foreground">Gente con Pasión Culinaria</h3>
        <p class="text-muted-foreground">Conoce a las personas talentosas detrás de las recetas tradicionales que deleitan tu paladar.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-card border border-border/80 rounded-2xl overflow-hidden shadow-xs hover:shadow-md hover:border-primary/30 transition-all duration-300 text-center flex flex-col items-center">
            <div class="w-full aspect-square overflow-hidden bg-muted flex items-center justify-center">
              <img 
                src={member.avatar} 
                alt={member.name} 
                class="object-cover h-full w-full object-center hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="p-6 space-y-2 flex-1 flex flex-col justify-center">
              <h4 class="font-bold text-lg text-foreground leading-tight">{member.name}</h4>
              <p class="text-sm font-semibold text-primary/80 tracking-wider uppercase">{member.role}</p>
              <p class="text-sm text-muted-foreground leading-relaxed">{member.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

</section>
